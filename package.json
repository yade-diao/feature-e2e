{
  "name": "feature-e2e",
  "version": "0.1.0",
  "description": "Record Playwright end-to-end tests from feature files: an agent walks each step in a real browser and emits a structured trace; a deterministic renderer compiles the trace into a spec.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "status": "node src/cli.mjs status",
    "check": "node src/cli.mjs check",
    "record": "node src/cli.mjs record",
    "replay": "node src/cli.mjs replay",
    "sync": "node src/cli.mjs sync",
    "test": "node --test src",
    "setup:agents": "playwright init-agents --loop=claude",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-playwright": "^2.11.0",
    "patch-package": "^8.0.1",
    "typescript-eslint": "^8.67.0"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "gherkin",
    "agent",
    "mcp",
    "test-generation"
  ],
  "engines": {
    "node": ">=20"
  }
}
