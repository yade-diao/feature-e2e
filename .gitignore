node_modules/
test-results/
playwright-report/
blob-report/

# Generated by `npm run setup:agents`, OS-specific (on Windows the MCP entry is
# `cmd /c npx ...`, on POSIX a bare command). Committing it hands the next person
# a config that does not run on their machine.
.mcp.json
.claude/agents/*
# The verify and judger agents are hand-written and part of the project (the
# Writer and the final arbiter — both core to recording); the planner / generator
# definitions are regenerated by `setup:agents`.
!.claude/agents/verify.md
!.claude/agents/judger.md

# Browser scratch output (console logs, page snapshots), one subtree per feature
# — see recorder.mjs's mcpOutputDir.
logs/
# Where the MCP server writes the same thing when PLAYWRIGHT_MCP_OUTPUT_DIR is
# unset.
.playwright-mcp/

# Cloned external knowledge bases — disposable working copies, the remote is the
# source of truth. Populated by `npm run sync`. See knowledge/.
knowledge/external/

# Written by the step reporter during a recording gate, deleted right after.
.step-report.json

# Red spec list left by a failed replay for `heal` to consume.
.red-specs.json

*.log

# Per-attempt recording measurements. Local signal, not a build artefact.
.recordings.jsonl

# The feature corpus stays local: a feature is a plain text file, but the ones
# here carry an environment's login table, and a recording only means something
# against the environment it was made on. The tool is what ships, not one
# environment's suite.
features/*
!features/README.md

# The run area — everything a recording produces (specs, traces, diagnoses) —
# stays local. A recording only means something against the environment it was
# made on. The seed is the exception: the agent needs it to open the
# application at all.
run/
!run/seed.spec.ts
reports/

# macOS directory metadata.
.DS_Store
